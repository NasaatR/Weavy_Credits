{
  "manifest_version": 3,
  "name": "WEAVY CREDITS",
  "version": "1.8.0",
  "description": "Расход по сохранённым генерациям Weavy, включая старые результаты. Тарифная оценка и подтверждённые списания раздельно.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://app.weavy.ai/*",
    "https://www.cbr.ru/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "WEAVY CREDITS — отчёт"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "panel.html?view=settings",
  "content_scripts": [
    {
      "matches": [
        "https://app.weavy.ai/*"
      ],
      "js": [
        "observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.weavy.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "version_name": "1.8.0",
  "homepage_url": "https://github.com/NasaatR/Weavy_Credits"
}
